---
// Fig. 3, Accessibility: a screen reader walks a payment form, finds an amount field with no label,
// and a loupe measures the hint text's contrast. Shared scene parts and state classes are in src/styles/loop.css.
import Phone from './Phone.astro';
import Tracker from './Tracker.astro';
import Finding from './Finding.astro';
import '../../styles/loop.css';
---

<figure
  class="loop a-loop"
  data-loop="accessibility"
  role="img"
  aria-label="Fig. 3, accessibility. A screen reader moves through a send money form. The heading and phone number are announced properly, but the amount field is read only as 'text field' because it has no label, and its grey hint text measures 2.5 to 1, below the 4.5 to 1 that WCAG AA requires. Bayrust logs it as a high-severity finding: add a visible label."
>
  <div class="loop-stage" aria-hidden="true">
    <div class="loop-scene">
      <span class="loop-chip glass">Fig. 3 · Contrast bench</span>

      <Phone class="loop-phone">
        <section class="app a-app">
          <p class="app-title a-target" data-target="1">Send money<span class="a-ring"></span></p>
          <p class="app-label">Phone number</p>
          <div class="a-field a-target" data-target="2">078 123 4567<span class="a-ring"></span></div>
          <div class="a-field a-target a-amount" data-target="3">
            <span class="a-hint">Enter amount</span>
            <span class="a-ring"></span>
            <span class="loop-markup" data-m="1"><em class="loop-markup-tag">No label</em></span>
            <span class="a-loupe">
              <span class="a-loupe-lens"><span>Enter</span></span>
              <span class="a-loupe-read"><b data-ratio>1.0</b> : 1 · Fails AA</span>
            </span>
          </div>
          <div class="app-btn a-btn a-target" data-target="4">Continue<span class="a-ring"></span></div>
          <div class="a-caption"><i></i><span data-caption>VoiceOver on</span></div>
        </section>
      </Phone>

      <Tracker
        title="Screen-reader pass"
        meta="VoiceOver"
        rows={[
          { label: 'Heading', value: 'Announced' },
          { label: 'Phone number', value: 'Labelled' },
          { label: 'Amount field', value: 'No label' },
          { label: 'Hint text', value: '2.5 : 1' },
        ]}
      />

      <svg class="loop-link" viewBox="0 0 520 340" preserveAspectRatio="none">
        <path d="M186 140 C 204 140, 196 250, 214 250" pathLength="1"></path>
        <circle cx="186" cy="140" r="2.2"></circle>
      </svg>

      <Finding
        lens="Accessibility"
        severity="High"
        title="Amount field has no label"
        evidence={['WCAG 4.1.2 · 1.4.3', 'Hint text 2.5 : 1']}
        fix="Add a visible label: Amount (RWF)"
      />
    </div>
  </div>
</figure>

<script>
  import { playLoop, countUp } from '../../scripts/loop';

  // Moves the screen-reader focus ring and updates the spoken caption.
  const focus = (target: string, caption: string) => (root: HTMLElement) => {
    root.dataset.focus = target;
    root.querySelector<HTMLElement>('[data-caption]')!.textContent = caption;
  };

  const ratio = (root: HTMLElement) => root.querySelector<HTMLElement>('[data-ratio]')!;

  document.querySelectorAll<HTMLElement>('[data-loop="accessibility"]').forEach((root) =>
    playLoop(root, {
      duration: 11000,
      steps: [
        { at: 0, add: 'is-reset', run: (r) => { focus('0', 'VoiceOver on')(r); ratio(r).textContent = '1.0'; } },
        { at: 200, add: 'is-in' },
        { at: 1000, add: 'is-sr is-v1', run: focus('1', 'Send money, heading') },
        { at: 2300, add: 'is-a1 is-v2', run: focus('2', 'Phone number, 078 123 4567, text field') },
        { at: 3700, add: 'is-a2 is-nolabel', run: focus('3', 'Text field. Double-tap to edit.') },
        { at: 4300, add: 'is-push is-mark1 is-v3 is-f3' },
        { at: 5500, add: 'is-a3 is-loupe', run: (r) => countUp(ratio(r), 2.5, 900) },
        { at: 6300, add: 'is-v4 is-f4' },
        { at: 6900, add: 'is-finding' },
        { at: 8800, add: 'is-release is-unloupe is-unlink is-unmark1', run: focus('4', 'Continue, button') },
        { at: 10300, add: 'is-out' },
      ],
      still: ['is-in', 'is-sr', 'is-nolabel', 'is-a3', 'is-v1', 'is-v2', 'is-v3', 'is-v4', 'is-f3', 'is-f4', 'is-mark1', 'is-loupe', 'is-finding'],
      settle: (r) => {
        focus('3', 'Text field. Double-tap to edit.')(r);
        ratio(r).textContent = '2.5';
      },
    }),
  );
</script>

<style>
  .a-app { gap: 0; }

  .a-target { position: relative; }

  .a-field {
    margin-top: 0.45em;
    padding: 0.9em 0.9em;
    border-radius: 0.8em;
    border: 1px solid var(--pebble);
    font-weight: 600;
  }

  .a-amount { margin-top: 1.4em; }

  .a-hint {
    color: #a3a3a3;
    font-weight: 400;
  }

  .a-btn { margin: auto 0 4.4em; }

  /* Screen-reader focus ring: the figure's script sets data-focus on the root */
  .a-ring {
    position: absolute;
    inset: -0.35em;
    border-radius: 0.9em;
    border: 0.18em solid var(--navy);
    box-shadow: 0 0 0 0.14em #fff, 0 0.6em 1.4em -0.6em rgba(19, 32, 46, 0.5);
    opacity: 0;
    transform: scale(1.08);
    transition: opacity 250ms var(--ease), transform 450ms var(--pop);
    pointer-events: none;
  }

  .a-btn .a-ring { border-radius: 99em; }

  .a-loop.is-sr[data-focus='1'] [data-target='1'] .a-ring,
  .a-loop.is-sr[data-focus='2'] [data-target='2'] .a-ring,
  .a-loop.is-sr[data-focus='3'] [data-target='3'] .a-ring,
  .a-loop.is-sr[data-focus='4'] [data-target='4'] .a-ring { opacity: 1; transform: none; }

  .a-loop.is-mark1:not(.is-unmark1) [data-target='3'] .a-ring { opacity: 0; }

  /* Spoken caption, like the screen reader's caption panel */
  .a-caption {
    position: absolute;
    left: 0.9em;
    right: 0.9em;
    bottom: 1em;
    display: flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.75em 0.9em;
    border-radius: 0.9em;
    font-size: 0.86em;
    line-height: 1.3;
    color: #fff;
    background: linear-gradient(180deg, rgba(36, 56, 77, 0.96), rgba(19, 32, 46, 0.96));
    box-shadow: 0 0.8em 1.6em -0.8em rgba(19, 32, 46, 0.8);
    opacity: 0;
    transform: translateY(1em);
    transition: opacity 400ms var(--ease), transform 600ms var(--pop), background 400ms var(--ease);
  }

  .a-caption i {
    flex: none;
    width: 0.7em;
    height: 0.7em;
    border-radius: 50%;
    background: #8fd0a5;
    box-shadow: 0 0 0 0.25em rgba(143, 208, 165, 0.25);
  }

  .a-loop.is-sr .a-caption { opacity: 1; transform: none; }
  .a-loop.is-nolabel .a-caption { background: linear-gradient(180deg, #c2511f, #a8441a); }
  .a-loop.is-nolabel .a-caption i { background: #fff; box-shadow: 0 0 0 0.25em rgba(255, 255, 255, 0.3); }
  .a-loop[data-focus='4'] .a-caption { background: linear-gradient(180deg, rgba(36, 56, 77, 0.96), rgba(19, 32, 46, 0.96)); }

  /* Contrast loupe over the hint text */
  .a-loupe {
    position: absolute;
    z-index: 2;
    left: 0.2em;
    top: calc(100% + 0.4em);
    display: grid;
    justify-items: center;
    gap: 0.4em;
    opacity: 0;
    transform: scale(0.6) translateY(-1em);
    transform-origin: 50% 0;
    transition: opacity 300ms var(--ease), transform 600ms var(--pop);
    pointer-events: none;
  }

  .a-loupe-lens {
    display: grid;
    place-items: center;
    width: 5em;
    height: 5em;
    border-radius: 50%;
    background: #fff;
    border: 0.22em solid transparent;
    background:
      linear-gradient(#fff, #fff) padding-box,
      conic-gradient(from 200deg, #c2511f, #ebc9b7, #13202e, #c2511f) border-box;
    box-shadow: 0 1em 2em -0.8em rgba(19, 32, 46, 0.6);
  }

  .a-loupe-lens span {
    font-size: 1.3em;
    color: #a3a3a3;
  }

  .a-loupe-read {
    padding: 0.3em 0.6em;
    border-radius: 0.5em;
    font-family: var(--font-mono);
    font-size: 0.74em;
    color: #fff;
    background: var(--rust);
    white-space: nowrap;
  }

  .a-loupe-read b { font-variant-numeric: tabular-nums; }

  .a-loop.is-loupe .a-loupe { opacity: 1; transform: none; }
  .a-loop.is-unloupe .a-loupe { opacity: 0; transform: scale(0.8); }
</style>
