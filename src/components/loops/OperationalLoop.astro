---
// Fig. 6, Operational: a loan application is filled in while the network falls from 4G to offline;
// autosave slows, then the draft is lost on submit. Shared scene parts are in src/styles/loop.css.
import Phone from './Phone.astro';
import Tracker from './Tracker.astro';
import Finding from './Finding.astro';
import '../../styles/loop.css';

const fields = [
  { label: 'Full name', value: 'Aline Uwase' },
  { label: 'National ID', value: '1 1990 8 0012345' },
  { label: 'Monthly income', value: 'RWF 350,000' },
];
---

<figure
  class="loop o-loop"
  data-loop="operational"
  role="img"
  aria-label="Fig. 6, operational. A customer fills in a loan application while the connection drops from 4G to 3G, 2G and then offline. Autosave slows from 0.4 to 6.8 seconds, and when they submit offline the whole draft is lost. Bayrust logs it as a high-severity finding: keep drafts on the device and retry when the connection returns."
>
  <div class="loop-stage" aria-hidden="true">
    <div class="loop-scene">
      <span class="loop-chip glass">Fig. 6 · Network emulator</span>

      <Phone class="loop-phone">
        <section class="app o-app">
          <p class="app-title">Loan application</p>
          <p class="o-save"><i></i><span data-save>New draft</span></p>
          <div class="o-fields">
            {
              fields.map((field, i) => (
                <div class="o-field">
                  <span>{field.label}</span>
                  <p>
                    <b data-field={i} data-value={field.value}></b>
                    <em>{field.label}</em>
                  </p>
                </div>
              ))
            }
            <span class="loop-markup" data-m="1"><em class="loop-markup-tag">Draft lost</em></span>
          </div>
          <div class="app-btn">Submit<span class="tap" data-tap="1"></span></div>
        </section>

        <span class="o-offline"></span>
        <div class="o-toast"><i>!</i><p>Connection lost. Please start again.</p></div>
      </Phone>

      <Tracker
        title="Autosave by network"
        meta="Throttled"
        rows={[
          { label: '4G', value: 'Saved · 0.4 s' },
          { label: '3G', value: 'Saved · 2.1 s' },
          { label: '2G', value: 'Slow · 6.8 s' },
          { label: 'Offline', value: 'Draft lost' },
        ]}
      />

      <svg class="loop-link" viewBox="0 0 520 340" preserveAspectRatio="none">
        <path d="M186 140 C 204 140, 196 250, 214 250" pathLength="1"></path>
        <circle cx="186" cy="140" r="2.2"></circle>
      </svg>

      <Finding
        lens="Operational"
        severity="High"
        title="The draft is lost when the connection drops"
        evidence={['Offline on submit', '3 fields lost']}
        fix="Keep drafts on the device and retry later"
      />
    </div>
  </div>
</figure>

<script>
  import { playLoop } from '../../scripts/loop';

  const field = (root: HTMLElement, i: number) => root.querySelector<HTMLElement>(`[data-field="${i}"]`)!;
  const save = (text: string) => (root: HTMLElement) => {
    root.querySelector<HTMLElement>('[data-save]')!.textContent = text;
  };

  // Types a field's value in over roughly `ms`.
  const type = (i: number, ms: number) => (root: HTMLElement) => {
    const el = field(root, i);
    const value = el.dataset.value!;
    [...value].forEach((_, n) => setTimeout(() => (el.textContent = value.slice(0, n + 1)), (ms / value.length) * n));
  };

  const clear = (root: HTMLElement) => [0, 1, 2].forEach((i) => (field(root, i).textContent = ''));

  document.querySelectorAll<HTMLElement>('[data-loop="operational"]').forEach((root) =>
    playLoop(root, {
      duration: 12000,
      steps: [
        { at: 0, add: 'is-reset', run: (r) => { clear(r); save('New draft')(r); } },
        { at: 200, add: 'is-in' },
        { at: 900, add: 'is-saving', run: type(0, 700) },
        { at: 1300, add: 'is-v1', run: save('Draft saved') },
        { at: 2300, add: 'is-net2 is-a1', run: type(1, 900) },
        { at: 3200, add: 'is-v2', run: save('Draft saved') },
        { at: 4300, add: 'is-net3 is-a2', run: (r) => { type(2, 800)(r); save('Saving…')(r); } },
        { at: 5800, add: 'is-v3 is-slow' },
        { at: 6300, add: 'is-net4 is-a3', run: save('Not saved') },
        { at: 6800, add: 'is-tap1' },
        { at: 7200, add: 'is-lost is-push is-mark1 is-v4 is-f4' },
        { at: 7900, add: 'is-finding' },
        { at: 10100, add: 'is-release is-unmark1 is-unlink' },
        { at: 11400, add: 'is-out' },
      ],
      still: ['is-in', 'is-net4', 'is-a3', 'is-v1', 'is-v2', 'is-v3', 'is-v4', 'is-f4', 'is-lost', 'is-mark1', 'is-finding'],
      settle: save('Not saved'),
    }),
  );
</script>

<style>
  .o-save {
    margin-top: 0.4em !important;
    display: flex;
    align-items: center;
    gap: 0.45em;
    font-size: 0.78em;
    color: var(--steel);
  }

  .o-save i {
    width: 0.6em;
    height: 0.6em;
    border-radius: 50%;
    background: var(--pebble);
    transition: background 300ms var(--ease);
  }

  .o-loop.is-v1 .o-save i { background: #5aa877; }
  .o-loop.is-net3 .o-save i { background: #d9a441; animation: o-pulse 900ms ease-in-out infinite; }
  .o-loop.is-net4 .o-save i { background: var(--rust); animation: none; }

  @keyframes o-pulse {
    50% { opacity: 0.3; }
  }

  .o-fields {
    position: relative;
    margin-top: 0.9em;
    display: grid;
    gap: 0.8em;
  }

  .o-field > span {
    display: block;
    margin-bottom: 0.35em;
    font-size: 0.78em;
    color: var(--steel);
  }

  .o-field p {
    position: relative;
    height: 2.8em;
    padding: 0 0.9em;
    display: flex;
    align-items: center;
    border-radius: 0.8em;
    border: 1px solid var(--pebble);
    font-weight: 600;
  }

  .o-field b {
    font-weight: 600;
    white-space: nowrap;
    transition: opacity 300ms var(--ease), filter 300ms var(--ease);
  }

  .o-field em {
    position: absolute;
    left: 0.9em;
    font-style: normal;
    font-weight: 400;
    color: var(--pebble);
    opacity: 0;
    transition: opacity 400ms var(--ease) 300ms;
  }

  .o-loop.is-lost .o-field b { opacity: 0; filter: blur(0.2em); }
  .o-loop.is-lost .o-field em { opacity: 1; }

  .o-fields .loop-markup { inset: -0.5em -0.4em; }

  /* The signal bars in the status bar weaken with each network step */
  .o-loop :global(.phone-status-icons i) { transition: opacity 300ms var(--ease); }

  .o-loop.is-net2 :global(.phone-status-icons i:nth-child(3)),
  .o-loop.is-net3 :global(.phone-status-icons i:nth-child(n + 2)),
  .o-loop.is-net4 :global(.phone-status-icons i) { opacity: 0.2; }

  /* The island widens to say the connection is gone */
  .o-offline {
    position: absolute;
    z-index: 7;
    top: 0.6em;
    left: 50%;
    display: grid;
    place-items: center;
    width: 4.1em;
    height: 1.2em;
    overflow: hidden;
    border-radius: 1em;
    font-size: 1em;
    white-space: nowrap;
    color: #fff;
    background: #000;
    opacity: 0;
    transform: translateX(-50%);
    transition: width 600ms var(--pop), opacity 200ms var(--ease);
  }

  .o-offline::before {
    content: 'No connection';
    font-size: 0.58em;
    font-weight: 700;
    opacity: 0;
    transition: opacity 300ms var(--ease) 250ms;
  }

  .o-loop.is-net4 .o-offline { width: 6.6em; opacity: 1; }
  .o-loop.is-net4 .o-offline::before { opacity: 1; }

  .o-toast {
    position: absolute;
    z-index: 7;
    left: 0.9em;
    right: 0.9em;
    bottom: 5.2em;
    display: flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.7em 0.8em;
    border-radius: 0.9em;
    font-size: 0.78em;
    font-weight: 600;
    line-height: 1.3;
    color: #fff;
    background: linear-gradient(180deg, #24384d, #13202e);
    box-shadow: 0 1em 2em -0.8em rgba(19, 32, 46, 0.8);
    opacity: 0;
    transform: translateY(1em) scale(0.95);
    transition: opacity 300ms var(--ease), transform 600ms var(--pop);
  }

  .o-toast i {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.6em;
    height: 1.6em;
    border-radius: 50%;
    font-style: normal;
    background: var(--rust);
  }

  .o-toast p { margin: 0; }

  .o-loop.is-lost .o-toast { opacity: 1; transform: none; }
  .o-loop.is-release .o-toast { opacity: 0; }
</style>
