---
// Fig. 5, User habits: across observed sessions, customers screenshot their withdrawal code and send it
// in a chat, while the Copy code button the product was built around goes unused. Shared parts in src/styles/loop.css.
import Phone from './Phone.astro';
import Tracker from './Tracker.astro';
import Finding from './Finding.astro';
import '../../styles/loop.css';

// Where observed presses landed on the code card, as % of the card.
const heat = [
  [28, 52], [46, 58], [62, 50], [38, 64], [55, 66], [70, 60], [44, 48],
];
---

<figure
  class="loop h-loop"
  data-loop="user-habits"
  role="img"
  aria-label="Fig. 5, user habits. On a withdrawal code screen, observed customers press and hold the code, take a screenshot and send it to the agent in a chat. In 7 of 9 sessions people screenshot the code, and nobody tapped the Copy code button. Bayrust logs it as a medium-severity finding: make the code shareable to a chat in one tap."
>
  <div class="loop-stage" aria-hidden="true">
    <div class="loop-scene">
      <span class="loop-chip glass">Fig. 5 · Tap camera</span>

      <Phone class="loop-phone">
        <section class="app h-app">
          <p class="app-title">Withdraw cash</p>
          <p class="h-note">Show this code to the agent</p>
          <div class="h-code">
            <span>Withdrawal code</span>
            <strong>482 913</strong>
            <em>Expires in 14:52</em>
            {heat.map(([x, y], i) => <i class="h-heat" style={`left: ${x}%; top: ${y}%; --d: ${i * 140}ms`}></i>)}
          </div>
          <div class="app-panel">
            <p><span>Amount</span><b>RWF 50,000</b></p>
            <p><span>Agent</span><b>Any agent</b></p>
          </div>
          <div class="app-btn h-copy">
            Copy code
            <span class="loop-markup" data-m="1"><em class="loop-markup-tag">0 of 9 taps</em></span>
          </div>
          <p class="h-share">Share</p>
        </section>

        <span class="h-flash"></span>
        <span class="h-thumb"><i></i><b></b><b></b></span>

        <div class="h-chat">
          <p class="h-chat-head"><i>JM</i><span>Jean · Agent<small>online</small></span></p>
          <div class="h-bubble">
            <span class="h-shot"><i></i><b></b><b></b></span>
            <p>Here is the code<small>Sent ✓✓</small></p>
          </div>
        </div>
      </Phone>

      <Tracker
        title="Field observation"
        meta="9 sessions"
        rows={[
          { label: 'Opened the code', value: '9 of 9' },
          { label: 'Took a screenshot', value: '7 of 9' },
          { label: 'Sent it in a chat', value: '6 of 9' },
          { label: 'Tapped Copy code', value: '0 of 9' },
        ]}
      />

      <svg class="loop-link" viewBox="0 0 520 340" preserveAspectRatio="none">
        <path d="M186 232 C 204 232, 198 250, 214 250" pathLength="1"></path>
        <circle cx="186" cy="232" r="2.2"></circle>
      </svg>

      <Finding
        lens="User habits"
        severity="Medium"
        title="Customers screenshot the code instead of copying it"
        evidence={['7 of 9 sessions', 'Copy code: 0 taps']}
        fix="Add one-tap Share to chat next to the code"
      />
    </div>
  </div>
</figure>

<script>
  import { playLoop } from '../../scripts/loop';

  document.querySelectorAll<HTMLElement>('[data-loop="user-habits"]').forEach((root) =>
    playLoop(root, {
      duration: 11200,
      steps: [
        { at: 200, add: 'is-in' },
        { at: 1000, add: 'is-heat is-v1' },
        { at: 2500, add: 'is-flash is-a1 is-v2' },
        { at: 3900, add: 'is-chat is-a2 is-v3' },
        { at: 5500, add: 'is-unchat is-push is-mark1 is-a3 is-v4 is-f4' },
        { at: 6400, add: 'is-finding' },
        { at: 8900, add: 'is-release is-unmark1 is-unlink' },
        { at: 10500, add: 'is-out' },
      ],
      still: ['is-in', 'is-heat', 'is-a3', 'is-v1', 'is-v2', 'is-v3', 'is-v4', 'is-f4', 'is-mark1', 'is-finding'],
    }),
  );
</script>

<style>
  .h-note {
    margin-top: 0.2em !important;
    font-size: 0.86em;
    color: var(--steel);
  }

  .h-code {
    position: relative;
    margin-top: 0.9em;
    padding: 1.1em 1.1em 1em;
    border-radius: 1.1em;
    color: #fff;
    overflow: hidden;
    background:
      radial-gradient(90% 120% at 100% 0%, rgba(194, 81, 31, 0.85), transparent 60%),
      linear-gradient(135deg, #24384d, #13202e 70%);
    box-shadow: 0 0.8em 1.6em -0.8em rgba(19, 32, 46, 0.6);
  }

  .h-code span { display: block; font-size: 0.78em; color: var(--mist); }

  .h-code strong {
    display: block;
    margin-top: 0.3em;
    font-family: var(--font-mono);
    font-size: 1.9em;
    letter-spacing: 0.06em;
  }

  .h-code em {
    display: block;
    margin-top: 0.5em;
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.72em;
    color: var(--fog);
  }

  /* Observed presses, building up like a heat map */
  .h-heat {
    position: absolute;
    width: 2.2em;
    height: 2.2em;
    margin: -1.1em 0 0 -1.1em;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 196, 150, 0.7) 0%, rgba(224, 115, 63, 0.5) 35%, rgba(194, 81, 31, 0) 70%);
    mix-blend-mode: screen;
    opacity: 0;
    transform: scale(0.3);
    transition: opacity 400ms var(--ease) var(--d), transform 600ms var(--pop) var(--d);
  }

  .h-loop.is-heat .h-heat { opacity: 1; transform: none; }

  .h-copy { margin-top: auto; }

  .h-share {
    margin-top: 0.7em !important;
    text-align: center;
    font-weight: 600;
    color: var(--steel);
  }

  /* Screenshot: a flash, then the thumbnail drops to the corner */
  .h-flash {
    position: absolute;
    inset: 0;
    z-index: 6;
    border-radius: inherit;
    background: #fff;
    opacity: 0;
    pointer-events: none;
  }

  .h-loop.is-flash .h-flash { animation: h-flash 500ms var(--ease); }

  @keyframes h-flash {
    20% { opacity: 0.9; }
  }

  .h-thumb,
  .h-shot {
    display: grid;
    align-content: start;
    gap: 0.35em;
    padding: 0.5em;
    border-radius: 0.6em;
    background: #fff;
  }

  .h-thumb i,
  .h-shot i {
    height: 2.2em;
    border-radius: 0.4em;
    background:
      radial-gradient(90% 120% at 100% 0%, rgba(194, 81, 31, 0.85), transparent 60%),
      linear-gradient(135deg, #24384d, #13202e 70%);
  }

  .h-thumb b,
  .h-shot b {
    height: 0.35em;
    border-radius: 0.2em;
    background: var(--stone);
  }

  .h-thumb b:last-child,
  .h-shot b:last-child { width: 60%; }

  .h-thumb {
    position: absolute;
    z-index: 7;
    left: 0.8em;
    bottom: 1em;
    width: 4.6em;
    height: 8.6em;
    box-shadow: 0 0.8em 1.6em -0.6em rgba(19, 32, 46, 0.6), 0 0 0 0.2em #fff;
    opacity: 0;
    transform: translate(3.4em, -8em) scale(2.6);
    transform-origin: 0 100%;
    transition: transform 700ms var(--ease) 200ms, opacity 200ms var(--ease) 200ms;
  }

  .h-loop.is-flash .h-thumb { opacity: 1; transform: none; }
  .h-loop.is-chat .h-thumb { opacity: 0; transform: translateX(-1em) scale(0.8); transition-delay: 0ms; }

  /* The chat the screenshot is sent into */
  .h-chat {
    position: absolute;
    z-index: 8;
    left: 0;
    right: 0;
    bottom: 0;
    height: 62%;
    padding: 1em;
    border-radius: 1.6em 1.6em 0 0;
    background: linear-gradient(180deg, #f8f6f2, #efebe5);
    box-shadow: 0 -1em 2em -1em rgba(19, 32, 46, 0.35);
    transform: translateY(105%);
    transition: transform 650ms var(--ease);
  }

  .h-loop.is-chat .h-chat { transform: none; }
  .h-loop.is-unchat .h-chat { transform: translateY(105%); }

  .h-chat p { margin: 0; }

  .h-chat-head {
    display: flex;
    align-items: center;
    gap: 0.6em;
    padding-bottom: 0.8em;
    border-bottom: 1px solid var(--line-strong);
    font-size: 0.86em;
    font-weight: 700;
    line-height: 1.2;
  }

  .h-chat-head i {
    display: grid;
    place-items: center;
    width: 2.2em;
    height: 2.2em;
    border-radius: 50%;
    font-style: normal;
    font-size: 0.8em;
    color: var(--steel);
    background: var(--stone);
  }

  .h-chat-head small { display: block; font-weight: 400; color: var(--steel); }

  .h-bubble {
    margin: 1em 0 0 auto;
    width: 8.4em;
    padding: 0.45em;
    border-radius: 1em 1em 0.3em 1em;
    background: linear-gradient(180deg, #24384d, #13202e);
    box-shadow: 0 0.6em 1.2em -0.6em rgba(19, 32, 46, 0.6);
    opacity: 0;
    transform: translateY(1em) scale(0.9);
    transform-origin: 100% 100%;
    transition: opacity 300ms var(--ease) 450ms, transform 600ms var(--pop) 450ms;
  }

  .h-loop.is-chat .h-bubble { opacity: 1; transform: none; }

  .h-shot { height: 7em; }

  .h-bubble p {
    padding: 0.5em 0.3em 0.1em;
    font-size: 0.8em;
    font-weight: 600;
    color: #fff;
    line-height: 1.3;
  }

  .h-bubble small { display: block; font-weight: 400; color: var(--fog); text-align: right; }
</style>
