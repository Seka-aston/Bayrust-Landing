---
// The small labelled pill with a rust dot that sits above section headings.
---

<span class="eyebrow"><span class="dot" aria-hidden="true"></span><slot /></span>

<style>
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--white);
    border: 1px solid rgba(19, 32, 46, 0.09);
    border-radius: 10px;
    padding: 6px 12px;
    font-size: 14px;
    font-weight: 500;
    color: var(--steel);
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--rust);
  }
</style>
