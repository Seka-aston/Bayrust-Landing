---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<ul class="checks">
  {
    items.map((item) => (
      <li>
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
          <circle cx="10" cy="10" r="10" fill="#C2511F" />
          <path d="M6 10.4l2.6 2.6L14.2 7.4" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        {item}
      </li>
    ))
  }
</ul>

<style>
  .checks {
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: 16px;
    line-height: 1.5;
  }

  svg {
    flex: none;
    margin-top: 2px;
  }
</style>
