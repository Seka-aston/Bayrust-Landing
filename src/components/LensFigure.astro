---
// The animated figure for each of the five lenses, shared by the home page tabs and the Five lenses page.
// Each one is a scripted loop in src/components/loops/.
import type { LensId } from '../data/lenses';
import UsabilityLoop from './loops/UsabilityLoop.astro';
import AccessibilityLoop from './loops/AccessibilityLoop.astro';
import SystemLogicLoop from './loops/SystemLogicLoop.astro';
import UserHabitsLoop from './loops/UserHabitsLoop.astro';
import OperationalLoop from './loops/OperationalLoop.astro';

interface Props {
  lens: LensId;
}

const loops = {
  usability: UsabilityLoop,
  accessibility: AccessibilityLoop,
  'system-logic': SystemLogicLoop,
  'user-habits': UserHabitsLoop,
  operational: OperationalLoop,
} satisfies Record<LensId, unknown>;

const Loop = loops[Astro.props.lens];
---

<Loop />
