---
import Layout from '../../layouts/Layout.astro';
import { site } from '../../data/site';

// Zoho sends subscribers here after they click "Confirm Subscription" in the confirmation email.
---

<Layout
  title="You’re subscribed"
  description="Your subscription to The Rust Report is confirmed."
  noindex
>
  <section aria-labelledby="confirmed-h" class="wrap">
    <div class="panel">
      <svg class="tick" width="56" height="56" viewBox="0 0 20 20" aria-hidden="true">
        <circle cx="10" cy="10" r="10" fill="#C2511F" />
        <path d="M6 10.4l2.6 2.6L14.2 7.4" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <p class="label">The Rust Report</p>
      <h1 id="confirmed-h">You’re subscribed</h1>
      <p class="lede">
        Thanks for confirming. Once a month you’ll get one finding, one tip and one update from the audits we run. Two
        minutes to read, and you can unsubscribe anytime.
      </p>

      <div class="tip">
        <p>
          To make sure it reaches your inbox, add{' '}
          <a href={`mailto:${site.founderEmail}`}>{site.founderEmail}</a> to your contacts.
        </p>
      </div>

      <div class="actions">
        <a href="/lenses" class="btn btn--primary">See how we audit</a>
        <a href="/" class="btn btn--secondary">Back to the homepage</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .wrap {
    padding: 40px var(--gutter) 120px;
  }

  .panel {
    max-width: 820px;
    margin: 0 auto;
    background: var(--paper);
    border-radius: 30px;
    padding: 72px 64px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }

  .tick {
    margin-bottom: 6px;
  }

  .label {
    margin: 0;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--rust-text);
  }

  h1 {
    margin: 0;
    font-size: clamp(40px, 5vw, 64px);
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  .lede {
    margin: 0;
    max-width: 34em;
    font-size: 19px;
    line-height: 1.65;
    color: var(--steel);
  }

  .tip {
    margin-top: 6px;
    padding: 14px 16px;
    background: var(--white);
    border-left: 3px solid var(--rust);
    border-radius: 0 10px 10px 0;
  }

  .tip p {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--navy);
  }

  .tip a {
    color: var(--rust-text);
    font-weight: 700;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 14px;
  }

  @media (max-width: 640px) {
    .wrap {
      padding: 24px var(--gutter) 80px;
    }

    .panel {
      padding: 40px 20px 24px;
      border-radius: 24px;
    }

    h1 {
      font-size: 40px;
    }

    .lede {
      font-size: 17px;
    }

    .actions,
    .actions .btn {
      width: 100%;
      justify-content: center;
      text-align: center;
    }
  }
</style>
