---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { caseStudies, featured, sectors, tones } from '../data/work';

const filters = ['All', ...sectors];
---

<Layout title="Our work" current="work">
  <section class="intro">
    <div class="intro-inner">
      <Eyebrow>Our work</Eyebrow>
      <h1 class="display-1">Rust we’ve found,<br /><span class="accent">and what changed.</span></h1>
      <p>
        Every case study here is published with the client’s permission, and follows the same structure: the challenge, what
        we inspected, the rust we found, and what changed after the re-check.
      </p>
    </div>
  </section>

  <!-- Featured case study -->
  <section aria-labelledby="feat-h" class="featured-wrap">
    <div class="featured">
      <div class="featured-image">[FEATURED CASE STUDY IMAGE]</div>
      <div class="featured-copy">
        <div class="featured-tags">
          <span class="tag tag--rust">Featured</span>
          <span class="tag">{featured.sector}</span>
        </div>
        <h2 id="feat-h">{featured.title}</h2>
        <div class="featured-grid">
          <div><h3>The challenge</h3><p>{featured.challenge}</p></div>
          <div><h3>What we inspected</h3><p>{featured.scope}</p></div>
          <div><h3>Rust we found</h3><p>{featured.found}</p></div>
          <div><h3>What changed</h3><p>{featured.changed}</p></div>
        </div>
        <a href={featured.href} class="btn btn--primary btn--sm">Read the case study</a>
      </div>
    </div>
  </section>

  <!-- All case studies -->
  <section aria-labelledby="all-h" class="section">
    <div class="container all">
      <div class="all-head">
        <h2 id="all-h">All case studies</h2>
        <div role="group" aria-label="Filter by sector" class="filters" data-filters>
          {
            filters.map((name, i) => (
              <button aria-pressed={i === 0 ? 'true' : 'false'} data-filter={name}>
                {name}
              </button>
            ))
          }
        </div>
      </div>
      <div class="case-grid" data-cases>
        {
          caseStudies.map((c, i) => {
            const [bg, fg] = tones[i % tones.length];
            return (
              <a href={c.href} class="case-card" data-sector={c.sector}>
                <div class="case-image" style={`background: ${bg}; color: ${fg}`}>
                  [CASE STUDY IMAGE]
                </div>
                <div class="case-copy">
                  <span class="case-sector">{c.sector}</span>
                  <h3>{c.title}</h3>
                  <p>{c.result}</p>
                </div>
              </a>
            );
          })
        }
      </div>
      <p class="visually-hidden" aria-live="polite" data-count></p>
    </div>
  </section>
</Layout>

<script>
  // Sector filter: show only the case studies that match the chosen sector.
  const group = document.querySelector<HTMLElement>('[data-filters]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-cases] [data-sector]')];
  const count = document.querySelector<HTMLElement>('[data-count]');
  if (group) {
    const buttons = [...group.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const pick = button.dataset.filter;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
        let shown = 0;
        cards.forEach((card) => {
          const match = pick === 'All' || card.dataset.sector === pick;
          card.hidden = !match;
          if (match) shown++;
        });
        if (count) count.textContent = `${shown} case ${shown === 1 ? 'study' : 'studies'} shown`;
      });
    });
  }
</script>

<style>
  .intro {
    padding: 96px var(--gutter) 56px;
  }

  .intro-inner {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 24px;
  }

  .intro-inner > p {
    margin: 0;
    max-width: 36em;
    font-size: 19px;
    line-height: 1.65;
    color: var(--steel);
  }

  /* Featured */
  .featured-wrap {
    padding: 0 var(--gutter) 72px;
  }

  .featured {
    max-width: var(--content-wide);
    margin: 0 auto;
    background: var(--white);
    border: 1px solid rgba(19, 32, 46, 0.07);
    border-radius: 30px;
    overflow: hidden;
    display: flex;
    flex-wrap: wrap;
  }

  .featured-image {
    flex: 1 1 440px;
    min-height: 420px;
    background: var(--navy);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--fog);
    font-size: 15px;
  }

  .featured-copy {
    flex: 999 1 480px;
    padding: 52px 48px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .featured-copy .btn {
    align-self: flex-start;
    margin-top: 6px;
  }

  .featured-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag {
    font-size: 13px;
    font-weight: 700;
    color: var(--navy);
    background: var(--paper);
    padding: 5px 11px;
    border-radius: 999px;
  }

  .tag--rust {
    color: var(--white);
    background: var(--rust-text);
  }

  .featured-copy h2 {
    margin: 0;
    font-size: clamp(30px, 3.4vw, 44px);
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 18px 28px;
  }

  .featured-grid h3 {
    margin: 0 0 6px;
    font-size: 15px;
    font-weight: 700;
  }

  .featured-grid p {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--steel);
  }

  @media (max-width: 640px) {
    .featured-image {
      flex-basis: 100%;
      min-height: 260px;
    }

    .featured-copy {
      flex-basis: 100%;
      padding: 32px 24px;
    }
  }

  /* All case studies */
  .all {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .all-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

  .all-head h2 {
    margin: 0;
    font-size: 32px;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .filters button {
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    padding: 10px 16px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--white);
    color: var(--navy);
  }

  .filters button:hover {
    border-color: var(--navy);
  }

  .filters button[aria-pressed='true'] {
    border-color: var(--navy);
    background: var(--navy);
    color: var(--white);
  }

  .case-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 330px), 1fr));
    gap: 20px;
  }

  .case-card {
    text-decoration: none;
    color: var(--navy);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 22px;
    padding: 14px 14px 26px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .case-card[hidden] {
    display: none;
  }

  .case-card:hover {
    border-color: var(--line-strong);
    color: var(--navy);
  }

  .case-image {
    height: 210px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
  }

  .case-copy {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 0 10px;
  }

  .case-sector {
    font-size: 13px;
    font-weight: 700;
    color: var(--rust-text);
  }

  .case-copy h3 {
    margin: 0;
    font-size: 20px;
    line-height: 1.3;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .case-copy p {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--steel);
  }
</style>
