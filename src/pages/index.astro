---
import Layout from '../layouts/Layout.astro';
import CheckList from '../components/CheckList.astro';
import LensFigure from '../components/LensFigure.astro';
import BayLoop from '../components/loops/BayLoop.astro';
import { Image } from 'astro:assets';
import founderPhoto from '../assets/founder.jpg';
import { lenses } from '../data/lenses';
import { faqs } from '../data/faqs';
import { site } from '../data/site';

const reportLenses = [
  { name: 'Usability', count: 4 },
  { name: 'Accessibility', count: 6 },
  { name: 'System logic', count: 3 },
  { name: 'User habits', count: 2 },
  { name: 'Operational', count: 5 },
];

// The hero report cycles through these; the first is the one shown when motion is reduced.
const reportFindings = [
  {
    id: 'AUD-009',
    title: 'Transfer form can’t be completed with a screen reader',
    lens: 'Accessibility',
    urgent: true,
    evidence: 'Screen-reader recording: the amount field has no label, so the form can’t be submitted.',
    fix: 'Add a visible label tied to the field, and announce validation errors as they appear.',
  },
  {
    id: 'AUD-014',
    title: 'Payment marked successful before the callback returns',
    lens: 'System logic',
    urgent: true,
    evidence: 'Network log: the success screen appears 1.8 s before the payment callback returns a failure.',
    fix: 'Show a pending state until the callback confirms the payment.',
  },
  {
    id: 'AUD-017',
    title: 'Draft transfer lost when the network drops',
    lens: 'Operational',
    urgent: true,
    evidence: 'Recording on a throttled 2G profile: the connection drops on submit and every field is cleared.',
    fix: 'Keep the draft on the device and retry when the connection returns.',
  },
  {
    id: 'AUD-020',
    title: 'Transfer fee shown only after the PIN step',
    lens: 'Usability',
    urgent: false,
    evidence: 'Session recordings: customers pause for about 6 s when the fee first appears after the PIN.',
    fix: 'Show the fee on the amount screen, before the PIN is asked for.',
  },
];

const proofPoints = ['Five lenses in every audit', 'Evidence behind every finding', 'Checked against WCAG 2.2 AA', 'Re-check included'];

// When teams call us: the four moments an outside inspection is worth it.
const moments = [
  {
    title: 'Before a launch',
    body: 'The cheapest moment to find rust is before your customers do. We can inspect prototypes, staging and beta builds.',
  },
  {
    title: 'Before you accept a vendor’s delivery',
    body: 'An independent check that what you paid for actually works, before the final invoice is signed.',
  },
  {
    title: 'When customers complain and nobody knows why',
    body: 'Support calls are rising, completion is falling, and the team can’t agree on the cause. We find it.',
  },
  {
    title: 'Once a year, as a health check',
    body: 'Products drift as features pile up. A yearly inspection catches the rust before it spreads.',
  },
];

const founderCredentials = [
  'Senior UX designer at a Nordic EdTech company, working on its design system and reviewing the quality of what teams ship',
  'Former lead product designer of a vehicle telematics platform',
  'Product designer since 2018, across food tech, software and education',
  'BSc (Hons) Entrepreneurial Leadership, First Class, African Leadership University',
];

const sectors = ['Banks', 'Fintechs', 'Public digital services', 'NGOs and programs', 'Software agencies'];

const reasons = [
  {
    title: 'Tested where your users are',
    body: 'Low-cost Android phones, slow and dropping networks, shared devices, mobile money and USSD. The conditions your product actually lives in.',
  },
  {
    title: 'Written for two readers',
    body: 'Engineers get reproduction steps, delivered straight into Jira, GitHub, Trello or a spreadsheet. Leaders get one page on what to fund first.',
  },
  {
    title: 'Independent by design',
    body: 'We don’t build software or sell tools, so there’s no follow-on contract to protect. The report says what’s true, not what’s convenient.',
  },
  {
    title: 'The re-check is included',
    body: 'Once your team ships the fixes, we inspect every one again and confirm the rust is really gone, with fresh evidence.',
  },
];

const caseTeasers = [
  { sector: 'Banking', bg: 'var(--navy)', fg: 'var(--fog)', result: '[ONE-LINE RESULT, e.g. what was found and what changed]' },
  { sector: 'Public services', bg: 'var(--rust-tint)', fg: 'var(--steel)', result: '[ONE-LINE RESULT]' },
  { sector: 'Fintech', bg: 'var(--stone)', fg: 'var(--steel)', result: '[ONE-LINE RESULT]' },
];
---

<Layout title="Home">
  <!-- Hero -->
  <section class="hero">
    <div class="hero-stripes" aria-hidden="true"></div>
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="hero-copy">
      <h1>Find the rust<br /><span class="accent">before your users do.</span></h1>
      <p>
        Independent audits for apps, websites and platforms. We test what your users experience and what your system
        actually does, on the phones and networks they really use. Every problem comes back with proof, a severity and a
        specific fix.
      </p>
      <div class="hero-actions">
        <a href="#contact" class="btn btn--primary hero-primary">Book a free scoping call</a>
        <a href="/report" class="btn btn--secondary">See a sample report</a>
      </div>
      <ul class="proof">
        {
          proofPoints.map((point) => (
            <li>
              <svg width="16" height="16" viewBox="0 0 20 20" aria-hidden="true">
                <circle cx="10" cy="10" r="10" fill="#C2511F" />
                <path d="M6 10.4l2.6 2.6L14.2 7.4" fill="none" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              {point}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Sample report window -->
    <div class="report" data-report>
      <div class="report-bar">
        <div class="report-dots" aria-hidden="true"><span></span><span></span><span></span></div>
        <div class="report-title"><span>Sample audit report: mobile banking app</span></div>
        <span class="report-spacer" aria-hidden="true"></span>
      </div>
      <div class="report-body">
        <aside class="report-side">
          <p class="side-label">Audit</p>
          <p class="side-name">Mobile banking app</p>
          <div class="side-row side-row--active"><span>All findings</span><span class="mono" data-count="20">20</span></div>
          {
            reportLenses.map((l) => (
              <div class:list={['side-row', { 'is-lens': l.name === reportFindings[0].lens }]} data-lens={l.name}>
                <span>{l.name}</span>
                <span class="mono" data-count={l.count}>{l.count}</span>
              </div>
            ))
          }
          <div class="side-note">Inspected on 12 devices and 3 network profiles</div>
        </aside>
        <div class="report-main">
          <div class="report-head">
            <div>
              <p class="report-h">Findings</p>
              <p class="report-sub">Sorted by severity, highest first</p>
            </div>
            <div class="sev-counts">
              <span class="sev sev--critical"><span data-count="2">2</span> Critical</span>
              <span class="sev sev--major"><span data-count="7">7</span> Major</span>
              <span class="sev sev--minor"><span data-count="11">11</span> Minor</span>
            </div>
          </div>
          <div class="findings">
            {
              reportFindings.map((f, i) => (
                <div class:list={['finding', { 'is-sel': i === 0 }]} data-finding={i}>
                  <span class:list={['finding-dot', { 'finding-dot--muted': !f.urgent }]} />
                  <span class="mono finding-id">{f.id}</span>
                  <span class="finding-title">{f.title}</span>
                  <span class="finding-lens">{f.lens}</span>
                  <span class="finding-timer" aria-hidden="true" />
                </div>
              ))
            }
          </div>
          <div class="finding-details">
            {
              reportFindings.map((f, i) => (
                <div class:list={['finding-detail', { 'is-sel': i === 0 }]} data-detail={i} aria-hidden={i === 0 ? undefined : 'true'}>
                  <div>
                    <p>Evidence</p>
                    <p>{f.evidence}</p>
                  </div>
                  <div>
                    <p>Recommended fix</p>
                    <p>{f.fix}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Sectors -->
  <section aria-label="Who we work with" class="sectors">
    <div class="container sectors-inner">
      <p class="sectors-lead">Built for products people <span>can’t afford to see fail.</span></p>
      <span class="sectors-rule" aria-hidden="true"></span>
      <div class="sectors-list">{sectors.map((s) => <span>{s}</span>)}</div>
    </div>
  </section>

  <!-- Five lenses tabs -->
  <section aria-labelledby="lens-h" class="lenses">
    <div class="container centered">
      <h2 id="lens-h" class="display-2">Five lenses, one inspection</h2>
      <p class="lead narrow">
        Most audits stop at what’s on the screen. Ours also tests the rules underneath, the habits of the people using it,
        and the conditions it has to survive. All five lenses, in every audit.
      </p>
      <div role="tablist" aria-label="Inspection lenses" class="tablist scroll-row" data-tabs>
        {
          lenses.map((lens, i) => (
            <button
              role="tab"
              id={`tab-${lens.id}`}
              aria-controls={`panel-${lens.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
            >
              {lens.name}
            </button>
          ))
        }
      </div>
      {
        lenses.map((lens, i) => (
          <div role="tabpanel" id={`panel-${lens.id}`} aria-labelledby={`tab-${lens.id}`} class="tabpanel" hidden={i !== 0}>
            <div class="tabpanel-copy">
              <h3>{lens.question}</h3>
              <p>{lens.summary}</p>
              <CheckList items={lens.highlights} />
              <a href={`/lenses#${lens.id}`} class="more">
                Read more about {lens.lower}
              </a>
            </div>
            <div class="figure-card">
              <div class="figure-ground">
                <LensFigure lens={lens.id} />
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Inspection bay -->
  <section aria-labelledby="bay-h" class="section">
    <div class="container--wide bay">
      <div class="bay-head">
        <h2 id="bay-h" class="display-2">Inside the<br />inspection bay</h2>
        <div class="bay-aside">
          <p>Your product goes up on the lift. Each lens has its own instrument, and every reading feeds the same report.</p>
          <a href="/process" class="btn btn--primary btn--sm">See the full process</a>
        </div>
      </div>
      <div class="bay-loop"><BayLoop /></div>
    </div>
  </section>

  <!-- Why Bayrust -->
  <section aria-labelledby="why-h" class="section">
    <div class="container centered">
      <h2 id="why-h" class="display-2">Proof, not opinions</h2>
      <p class="lead narrow">
        What makes a Bayrust report something your team acts on the same week, instead of a document that sits in a folder.
      </p>
      <div class="why-grid">
        <div class="why-feature">
          <div class="tag-stack" aria-hidden="true" data-tags>
            <span class="tag-ghost"></span>
            <span class="tag-ghost"></span>
            <div class="tag-card">
              <span class="tag-hole"></span>
              <div class="tag-top"><span class="mono" data-tag="id">AUD-014</span><span class="mono tag-sev" data-tag="sev">Major</span></div>
              <span class="tag-title" data-tag="title">Payment marked successful before the callback returns</span>
              <div class="tag-foot">
                <span class="tag-lens" data-tag="lens">System logic</span>
                <span class="mono tag-evidence"><i></i><span data-tag="evidence">Recording 0:14</span></span>
              </div>
            </div>
          </div>
          <div class="why-feature-copy">
            <h3>Every finding is a tagged part</h3>
            <p>An ID, a lens, a severity, replayable evidence and a specific fix. Nothing vague, nothing to argue about.</p>
          </div>
        </div>
        {
          reasons.map((r) => (
            <div class="why-card">
              <h3>{r.title}</h3>
              <p>{r.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- When teams call us -->
  <section aria-labelledby="when-h" class="section">
    <div class="container when">
      <div class="when-head">
        <h2 id="when-h" class="display-2">You don’t need a crisis to need an audit</h2>
        <p class="lead">
          The teams closest to a product are the last to see its rust. An outside inspection is worth it at four moments.
        </p>
      </div>
      <div class="when-grid">
        {
          moments.map((m) => (
            <div class="when-card">
              <h3>{m.title}</h3>
              <p>{m.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Who inspects your product -->
  <section aria-labelledby="who-h" class="section">
    <div class="container--wide who">
      <div class="who-photo">
        <Image src={founderPhoto} alt="Aston Guevara Seka, founder of Bayrust" widths={[360, 540, 720]} sizes="(max-width: 880px) 100vw, 420px" />
      </div>
      <div class="who-copy">
        <h2 id="who-h">Led by a product designer, not a sales team</h2>
        <p>
          Bayrust is led by Aston Guevara Seka, who has spent eight years designing digital products and reviewing what
          development teams actually ship. Every audit is done by people who have built products themselves, so every fix we
          recommend is one a real team can ship.
        </p>
        <CheckList items={founderCredentials} />
        <a href={site.founderLinkedin} class="who-link" rel="me">Aston on LinkedIn</a>
      </div>
    </div>
  </section>

  <!-- Our work teaser -->
  <section aria-labelledby="work-h" class="section">
    <div class="container work">
      <div class="work-head">
        <div class="work-title">
          <h2 id="work-h" class="display-2">Rust we’ve found</h2>
        </div>
        <a href="/work" class="btn btn--secondary btn--sm">View all case studies</a>
      </div>
      <div class="case-grid">
        {
          caseTeasers.map((c) => (
            <a href="/work" class="case-card">
              <div class="case-image" style={`background: ${c.bg}; color: ${c.fg}`}>
                [CASE STUDY IMAGE]
              </div>
              <div class="case-copy">
                <span class="case-sector">{c.sector}</span>
                <h3>[CASE STUDY TITLE]</h3>
                <p>{c.result}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section aria-labelledby="quote-h" class="section">
    <div class="container centered">
      <h2 id="quote-h" class="display-2">What teams say after the re-check</h2>
      <div class="quote">
        <div class="quote-copy">
          <div>
            <p class="quote-name">[CLIENT NAME]</p>
            <p class="quote-role">[ROLE, ORGANISATION]</p>
          </div>
          <blockquote>“[CLIENT QUOTE about what the audit revealed and what changed afterwards.]”</blockquote>
          <div class="quote-stats">
            <div><p>[RESULT]</p><p>[WHAT IT MEASURES]</p></div>
            <div><p>[RESULT]</p><p>[WHAT IT MEASURES]</p></div>
          </div>
        </div>
        <div class="quote-photo">[CLIENT PHOTO]</div>
      </div>
      <div class="carousel">
        <button aria-label="Previous testimonial">
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M11 4L6 9l5 5" fill="none" stroke="#13202E" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </button>
        <div class="carousel-dots" aria-hidden="true"><span class="on"></span><span></span><span></span></div>
        <button aria-label="Next testimonial">
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M7 4l5 5-5 5" fill="none" stroke="#13202E" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </button>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" aria-labelledby="faq-h" class="section">
    <div class="container faq">
      <div class="faq-intro">
        <h2 id="faq-h">Questions teams ask before an audit</h2>
        <p>Can’t find yours? Ask us at {site.email}.</p>
      </div>
      <div class="faq-list" data-faq>
        {
          faqs.map((f, i) => (
            <div class="faq-item">
              <button aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`faq-${i}`} id={`faq-q-${i}`}>
                {f.q}
                <span class="faq-icon" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 12 12">
                    <path d="M3 6h6" stroke-width="1.8" stroke-linecap="round" />
                    <path class="faq-plus" d="M6 3v6" stroke-width="1.8" stroke-linecap="round" />
                  </svg>
                </span>
              </button>
              <div id={`faq-${i}`} role="region" aria-labelledby={`faq-q-${i}`} hidden={i !== 0}>
                <p>{f.a}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<script>
  import { countUp, playLoop } from '../scripts/loop';

  // Hero report: counts up as it lifts in, then walks through the findings while it is on screen.
  const report = document.querySelector<HTMLElement>('[data-report]');
  if (report && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const rows = [...report.querySelectorAll<HTMLElement>('[data-finding]')];
    const details = [...report.querySelectorAll<HTMLElement>('[data-detail]')];
    const lensRows = [...report.querySelectorAll<HTMLElement>('[data-lens]')];
    const lensOf = rows.map((row) => row.querySelector('.finding-lens')!.textContent);
    let current = 0;
    let timer = 0;
    let visible = false;
    let hovered = false;

    const show = (index: number) => {
      current = index;
      rows.forEach((row, i) => row.classList.toggle('is-sel', i === index));
      details.forEach((detail, i) => {
        detail.classList.toggle('is-sel', i === index);
        if (i === index) detail.removeAttribute('aria-hidden');
        else detail.setAttribute('aria-hidden', 'true');
      });
      lensRows.forEach((row) => row.classList.toggle('is-lens', row.dataset.lens === lensOf[index]));
    };

    const run = () => {
      clearTimeout(timer);
      report.classList.toggle('is-cycling', visible && !hovered);
      if (visible && !hovered) timer = window.setTimeout(() => (show((current + 1) % rows.length), run()), 4200);
    };

    report.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
      el.textContent = '0';
      setTimeout(() => countUp(el, Number(el.dataset.count), 1200, 0), 700);
    });
    new IntersectionObserver(([entry]) => ((visible = entry.isIntersecting), run()), { threshold: 0.3 }).observe(report);
    report.addEventListener('pointerenter', () => ((hovered = true), run()));
    report.addEventListener('pointerleave', () => ((hovered = false), run()));
  }

  // Why Bayrust: finding tags drop in, get stamped field by field, then are filed into the stack.
  const tagFindings = [
    { id: 'AUD-014', sev: 'Major', title: 'Payment marked successful before the callback returns', lens: 'System logic', evidence: 'Network log' },
    { id: 'AUD-009', sev: 'Critical', title: 'Transfer form can’t be completed with a screen reader', lens: 'Accessibility', evidence: 'Recording 0:42' },
    { id: 'AUD-017', sev: 'Major', title: 'Draft transfer lost when the network drops', lens: 'Operational', evidence: 'Recording 0:14' },
  ];
  document.querySelectorAll<HTMLElement>('[data-tags]').forEach((root) => {
    const field = (name: string) => root.querySelector<HTMLElement>(`[data-tag="${name}"]`)!;
    let next = 0;
    playLoop(root, {
      duration: 5800,
      steps: [
        {
          at: 0,
          add: 'is-live',
          run: () => {
            const f = tagFindings[next];
            next = (next + 1) % tagFindings.length;
            field('id').textContent = '';
            (['sev', 'title', 'lens', 'evidence'] as const).forEach((k) => (field(k).textContent = f[k]));
            root.classList.toggle('is-critical', f.sev === 'Critical');
            [...f.id].forEach((_, n) => setTimeout(() => (field('id').textContent = f.id.slice(0, n + 1)), 650 + n * 55));
          },
        },
        { at: 100, add: 'is-drop' },
        { at: 1100, add: 'is-sev' },
        { at: 1400, add: 'is-title' },
        { at: 1700, add: 'is-meta' },
        { at: 4900, add: 'is-file' },
      ],
      still: ['is-drop', 'is-sev', 'is-title', 'is-meta'],
    });
  });

  // Lens tabs: click or use the arrow keys to switch.
  const tablist = document.querySelector<HTMLElement>('[data-tabs]');
  if (tablist) {
    const tabs = [...tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (index: number) => {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        document.getElementById(tab.getAttribute('aria-controls')!)!.hidden = !on;
      });
      tabs[index].scrollIntoView({ block: 'nearest', inline: 'nearest' });
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (e) => {
        const keys: Record<string, number> = {
          ArrowRight: (i + 1) % tabs.length,
          ArrowLeft: (i - 1 + tabs.length) % tabs.length,
          Home: 0,
          End: tabs.length - 1,
        };
        if (e.key in keys) {
          e.preventDefault();
          select(keys[e.key]);
          tabs[keys[e.key]].focus();
        }
      });
    });
  }

  // FAQ accordion: one answer open at a time.
  const faq = document.querySelector<HTMLElement>('[data-faq]');
  if (faq) {
    const buttons = [...faq.querySelectorAll<HTMLButtonElement>('button[aria-expanded]')];
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const opening = button.getAttribute('aria-expanded') !== 'true';
        buttons.forEach((b) => {
          const open = b === button && opening;
          b.setAttribute('aria-expanded', String(open));
          document.getElementById(b.getAttribute('aria-controls')!)!.hidden = !open;
        });
      });
    });
  }
</script>

<style>
  /* Hero */
  .hero {
    position: relative;
    padding: 88px var(--gutter) 0;
  }

  .hero-stripes {
    position: absolute;
    inset: -80px 0 auto 0;
    height: 760px;
    background: repeating-linear-gradient(
      90deg,
      rgba(194, 81, 31, 0) 0px,
      rgba(194, 81, 31, 0) 70px,
      rgba(194, 81, 31, 0.1) 70px,
      rgba(194, 81, 31, 0.02) 112px
    );
    -webkit-mask-image: linear-gradient(180deg, #000 0%, rgba(0, 0, 0, 0.35) 55%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 0%, rgba(0, 0, 0, 0.35) 55%, transparent 100%);
  }

  .hero-glow {
    position: absolute;
    left: 50%;
    top: -40px;
    width: 900px;
    max-width: 100%;
    height: 600px;
    transform: translateX(-50%);
    background: radial-gradient(closest-side, var(--ground) 55%, rgba(250, 249, 247, 0));
  }

  .hero-copy {
    position: relative;
    max-width: 880px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 26px;
  }

  h1 {
    margin: 0;
    font-size: clamp(48px, 6.6vw, 88px);
    line-height: 1.02;
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  .hero-copy > p {
    margin: 0;
    max-width: 40em;
    font-size: 19px;
    line-height: 1.65;
    color: var(--steel);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .hero-primary {
    box-shadow: 0 8px 20px rgba(194, 81, 31, 0.3);
  }

  .proof {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 26px;
    font-size: 14px;
    font-weight: 600;
    color: var(--steel);
  }

  .proof li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  /* Sample report */
  .report {
    position: relative;
    max-width: var(--content);
    margin: 72px auto 0;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 22px;
    box-shadow: 0 2px 4px rgba(19, 32, 46, 0.04), 0 40px 80px rgba(19, 32, 46, 0.1);
    padding: 10px;
  }

  .report-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 6px 10px 12px;
  }

  .report-dots {
    display: flex;
    gap: 7px;
  }

  .report-dots span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #E3E1DC;
  }

  .report-title {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .report-title span {
    background: var(--paper);
    border-radius: 8px;
    padding: 5px 18px;
    font-size: 13px;
    color: var(--steel);
  }

  .report-spacer {
    width: 47px;
  }

  .report-body {
    border: 1px solid rgba(19, 32, 46, 0.07);
    border-radius: 14px;
    display: flex;
    flex-wrap: wrap;
    min-height: 500px;
    overflow: hidden;
  }

  .report-side {
    flex: 1 1 240px;
    max-width: 280px;
    background: var(--ground);
    border-right: 1px solid rgba(19, 32, 46, 0.07);
    padding: 22px 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .side-label {
    margin: 0 8px 4px;
    font-size: 13px;
    color: var(--steel);
  }

  .side-name {
    margin: 0 8px 16px;
    font-size: 17px;
    font-weight: 700;
  }

  .side-row {
    display: flex;
    justify-content: space-between;
    padding: 10px 12px;
    border-radius: 10px;
    font-size: 14px;
    color: var(--steel);
    transition: background 400ms ease, color 400ms ease, box-shadow 400ms ease;
  }

  .side-row.is-lens {
    color: var(--navy);
    font-weight: 600;
    background: rgba(251, 239, 232, 0.8);
    box-shadow: inset 3px 0 0 var(--rust);
  }

  .side-row--active {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 10px;
    font-weight: 600;
    color: var(--navy);
  }

  .side-note {
    margin-top: auto;
    padding: 14px 12px 0;
    border-top: 1px solid rgba(19, 32, 46, 0.07);
    font-size: 13px;
    line-height: 1.5;
    color: var(--steel);
  }

  .report-main {
    flex: 999 1 520px;
    min-width: 0;
    padding: 26px 28px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .report-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px;
  }

  .report-h {
    margin: 0;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .report-sub {
    margin: 4px 0 0;
    font-size: 14px;
    color: var(--steel);
  }

  .sev-counts {
    display: flex;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
  }

  .sev {
    border-radius: 8px;
    padding: 6px 10px;
  }

  .sev--critical { background: var(--navy); color: var(--white); }
  .sev--major { background: var(--steel); color: var(--white); }
  .sev--minor { background: var(--stone); color: var(--navy); }

  .findings {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
  }

  .finding {
    position: relative;
    display: grid;
    grid-template-columns: 16px 92px minmax(0, 1fr) 120px;
    gap: 14px;
    align-items: center;
    padding: 15px 18px;
    border-top: 1px solid rgba(19, 32, 46, 0.07);
    font-size: 15px;
    transition: background 400ms ease;
  }

  .finding:first-child { border-top: 0; }

  .finding.is-sel { background: var(--rust-tint); }

  /* Fills while a finding is selected, then the report moves to the next one */
  .finding-timer {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--rust);
    transform: scaleX(0);
    transform-origin: left;
  }

  .report.is-cycling .finding.is-sel .finding-timer { animation: report-timer 4200ms linear forwards; }

  @keyframes report-timer {
    to { transform: scaleX(1); }
  }

  .finding-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--rust);
  }

  .finding-dot--muted { background: var(--pebble); }

  .finding-id {
    font-size: 13px;
    color: var(--steel);
  }

  .finding-title { font-weight: 600; }

  .finding-lens {
    font-size: 13px;
    color: var(--steel);
  }

  .finding-details { display: grid; }

  .finding-detail {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 14px;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 400ms ease, transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }

  .finding-detail.is-sel {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .finding-detail > div {
    background: var(--ground);
    border-radius: 12px;
    padding: 16px 18px;
  }

  .finding-detail p {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
  }

  .finding-detail p:first-child {
    margin-bottom: 6px;
    font-size: 13px;
    font-weight: 700;
    color: var(--steel);
  }

  /* The report lifts in as the page opens */
  @media (prefers-reduced-motion: no-preference) {
    .report { animation: report-in 1200ms cubic-bezier(0.22, 1, 0.36, 1) 250ms both; }

    .finding { animation: report-row 600ms cubic-bezier(0.22, 1, 0.36, 1) both; }
    .finding:nth-child(1) { animation-delay: 800ms; }
    .finding:nth-child(2) { animation-delay: 890ms; }
    .finding:nth-child(3) { animation-delay: 980ms; }
    .finding:nth-child(4) { animation-delay: 1070ms; }
  }

  @keyframes report-in {
    from { opacity: 0; transform: perspective(1800px) rotateX(14deg) translateY(48px) scale(0.96); }
  }

  @keyframes report-row {
    from { opacity: 0; transform: translateY(10px); }
  }

  @media (max-width: 640px) {
    .report { margin-top: 48px; padding: 6px; border-radius: 18px; }
    .report-bar { padding: 6px 8px 10px; gap: 10px; }
    .report-dots span { width: 9px; height: 9px; }
    .report-title { min-width: 0; }
    .report-title span { min-width: 0; padding: 4px 12px; font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .report-spacer { display: none; }
    .report-body { min-height: 0; border-radius: 12px; }
    .report-side { display: none; }
    .report-main { padding: 20px 16px; }
    .finding { grid-template-columns: 12px auto minmax(0, 1fr); column-gap: 10px; row-gap: 4px; padding: 13px 14px; }
    .finding-title { grid-column: 2 / -1; grid-row: 1; }
    .finding-id { grid-column: 2; grid-row: 2; }
    .finding-lens { grid-column: 3; grid-row: 2; }
    .finding-dot { grid-row: 1; align-self: start; margin-top: 6px; }
    .finding-detail > div { padding: 14px 16px; }
  }

  /* Sectors */
  .sectors {
    padding: 72px var(--gutter) 24px;
  }

  .sectors-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px 48px;
  }

  .sectors-lead {
    margin: 0;
    flex: 0 1 300px;
    font-size: 18px;
    line-height: 1.45;
    font-weight: 600;
  }

  .sectors-lead span { color: var(--rust-text); }

  .sectors-rule {
    width: 1px;
    height: 48px;
    background: rgba(19, 32, 46, 0.12);
  }

  @media (max-width: 860px) {
    .sectors-rule { display: none; }
  }

  .sectors-list {
    flex: 1 1 520px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 34px;
    font-size: 19px;
    font-weight: 700;
    color: var(--steel);
  }

  /* Shared centred section header */
  .centered {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
  }

  .centered > .display-2,
  .narrow {
    text-align: center;
  }

  .narrow { max-width: 36em; }

  /* Lens tabs */
  .lenses {
    padding: 120px var(--gutter);
  }

  .tablist {
    width: 100%;
    margin-top: 26px;
    display: flex;
    flex-wrap: wrap;
    border-bottom: 1px solid rgba(19, 32, 46, 0.1);
  }

  [role='tab'] {
    flex: 1 1 160px;
    background: none;
    border: 0;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    padding: 16px 10px;
    font-size: 16px;
    font-weight: 500;
    color: var(--steel);
    cursor: pointer;
  }

  [role='tab']:hover { color: var(--navy); }

  [role='tab'][aria-selected='true'] {
    border-bottom-color: var(--rust);
    font-weight: 700;
    color: var(--navy);
  }

  .tabpanel {
    width: 100%;
    margin-top: 40px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
    gap: 48px;
    align-items: center;
  }

  .tabpanel[hidden] { display: none; }

  .tabpanel-copy {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .tabpanel-copy h3 {
    margin: 0;
    font-size: 30px;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .tabpanel-copy > p {
    margin: 0;
    font-size: 17px;
    line-height: 1.65;
    color: var(--steel);
  }

  .more {
    margin-top: 6px;
    align-self: flex-start;
    font-size: 16px;
    font-weight: 700;
  }

  .figure-card {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 22px;
    padding: 18px;
    box-shadow: var(--shadow-card);
  }

  .figure-ground {
    background: var(--rust-tint);
    border-radius: 14px;
    min-height: 320px;
    padding: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* A lens figure is its own plate, so the tinted ground steps aside for it. */
  .figure-ground:has(.loop) {
    min-height: 0;
    padding: 0;
    background: none;
  }

  /* Inspection bay */
  .bay {
    background: var(--white);
    border: 1px solid rgba(19, 32, 46, 0.07);
    border-radius: 28px;
    padding: 64px 56px 40px;
  }

  .bay-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px 48px;
  }

  .bay-head h2 {
    flex: 1 1 420px;
    line-height: 1.06;
  }

  .bay-aside {
    flex: 0 1 380px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    align-items: flex-start;
  }

  .bay-aside p {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--steel);
  }

  .bay-loop { margin-top: 40px; }

  @media (max-width: 640px) {
    .bay { padding: 40px 20px 20px; }
  }

  /* Why Bayrust */
  .why-grid {
    width: 100%;
    margin-top: 32px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 20px;
  }

  .why-feature {
    grid-row: span 2;
    background: var(--navy);
    color: var(--white);
    border-radius: 22px;
    padding: 36px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
    min-height: 460px;
  }

  .tag-stack {
    position: relative;
    display: grid;
  }

  .tag-card,
  .tag-ghost {
    grid-area: 1 / 1;
    border-radius: 16px;
  }

  /* Filed tags waiting behind the live one */
  .tag-ghost {
    background: rgba(244, 241, 236, 0.14);
    border: 1px solid rgba(244, 241, 236, 0.12);
    transform: translateY(-12px) scale(0.94) rotate(-3.5deg);
  }

  .tag-ghost + .tag-ghost {
    background: rgba(244, 241, 236, 0.24);
    transform: translateY(-6px) scale(0.97) rotate(-2.8deg);
  }

  .tag-card {
    position: relative;
    background: var(--paper);
    color: var(--navy);
    padding: 22px 22px 22px 50px;
    transform: rotate(-2deg);
    transform-origin: 25px 31px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    box-shadow: 0 24px 40px -24px rgba(0, 0, 0, 0.6);
  }

  .tag-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }

  .tag-evidence {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--steel);
  }

  .tag-evidence i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--rust);
    box-shadow: 0 0 0 3px rgba(194, 81, 31, 0.18);
  }

  .tag-stack.is-critical .tag-sev { background: var(--navy); }

  /* Played while on screen: drop in on its string, stamp each field, then file it */
  .tag-stack.is-live:not(.is-still) .tag-card {
    opacity: 0;
    transform: translateY(-40px) rotate(-12deg);
    transition: opacity 300ms ease, transform 1000ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .tag-stack.is-live.is-drop .tag-card { opacity: 1; transform: rotate(-2deg); }

  .tag-stack.is-live.is-file .tag-card {
    opacity: 0;
    transform: translateY(-14px) scale(0.94) rotate(-3.5deg);
    transition: opacity 500ms ease, transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .tag-stack.is-live:not(.is-still) :is(.tag-sev, .tag-title, .tag-foot) {
    opacity: 0;
    transition: opacity 300ms ease, transform 500ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .tag-stack.is-live:not(.is-still) .tag-sev { transform: scale(1.8) rotate(8deg); }
  .tag-stack.is-live:not(.is-still) .tag-title,
  .tag-stack.is-live:not(.is-still) .tag-foot { transform: translateY(6px); }

  .tag-stack.is-live.is-sev .tag-card .tag-sev,
  .tag-stack.is-live.is-title .tag-card .tag-title,
  .tag-stack.is-live.is-meta .tag-card .tag-foot { opacity: 1; transform: none; }

  .tag-hole {
    position: absolute;
    left: 18px;
    top: 24px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--navy);
    box-shadow: inset 0 0 0 3px var(--rust);
  }

  .tag-top {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    font-size: 13px;
    color: var(--steel);
  }

  .tag-sev {
    font-size: 12px;
    background: var(--steel);
    color: var(--white);
    padding: 3px 9px;
    border-radius: 6px;
  }

  .tag-title {
    font-size: 17px;
    font-weight: 700;
    line-height: 1.35;
  }

  .tag-lens {
    font-size: 13px;
    color: var(--rust-text);
    font-weight: 700;
  }

  .why-feature-copy,
  .why-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .why-feature-copy h3 {
    margin: 0;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .why-feature-copy p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--mist);
  }

  .why-card {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 22px;
    padding: 32px;
  }

  .why-card h3 {
    margin: 0;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .why-card p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--steel);
  }

  /* When teams call us */
  .when {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .when-head {
    display: flex;
    flex-direction: column;
    gap: 18px;
    align-items: flex-start;
    max-width: 760px;
  }

  .when-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
    gap: 18px;
  }

  .when-card {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 22px;
    padding: 30px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .when-card h3 {
    margin: 0;
    font-size: 21px;
    line-height: 1.3;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .when-card p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--steel);
  }

  /* Who inspects your product */
  .who {
    background: var(--white);
    border: 1px solid rgba(19, 32, 46, 0.07);
    border-radius: 30px;
    overflow: hidden;
    display: flex;
    flex-wrap: wrap;
  }

  .who-photo {
    position: relative;
    flex: 1 1 360px;
    min-height: 440px;
    background: var(--paper);
  }

  .who-photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
  }

  .who-copy {
    flex: 999 1 520px;
    padding: 56px 52px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .who-copy h2 {
    margin: 0;
    font-size: clamp(32px, 3.8vw, 48px);
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: -0.035em;
  }

  .who-copy > p {
    margin: 0;
    font-size: 17px;
    line-height: 1.65;
    color: var(--steel);
  }

  .who-copy :global(.checks) {
    margin: 0;
  }

  .who-link {
    font-size: 16px;
    font-weight: 700;
  }

  @media (max-width: 640px) {
    .who-photo {
      min-height: 280px;
    }

    .who-copy {
      padding: 36px 24px;
    }
  }

  /* Our work teaser */
  .work {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .work-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
  }

  .work-title {
    display: flex;
    flex-direction: column;
    gap: 18px;
    align-items: flex-start;
  }

  .case-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 330px), 1fr));
    gap: 20px;
  }

  .case-card {
    text-decoration: none;
    color: var(--navy);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 22px;
    padding: 14px 14px 26px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .case-card:hover { border-color: var(--line-strong); color: var(--navy); }

  .case-image {
    height: 220px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
  }

  .case-copy {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 0 10px;
  }

  .case-sector {
    font-size: 13px;
    font-weight: 700;
    color: var(--rust-text);
  }

  .case-copy h3 {
    margin: 0;
    font-size: 21px;
    line-height: 1.3;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .case-copy p {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--steel);
  }

  /* Testimonials */
  .quote {
    width: 100%;
    margin-top: 28px;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 26px;
    overflow: hidden;
    display: flex;
    flex-wrap: wrap;
    box-shadow: var(--shadow-card);
  }

  .quote-copy {
    flex: 999 1 460px;
    padding: 48px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 36px;
  }

  .quote-name {
    margin: 0 0 6px;
    font-size: 19px;
    font-weight: 700;
  }

  .quote-role {
    margin: 0;
    font-size: 15px;
    color: var(--steel);
  }

  blockquote {
    margin: 0;
    font-size: 24px;
    line-height: 1.5;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .quote-stats {
    display: flex;
    flex-wrap: wrap;
