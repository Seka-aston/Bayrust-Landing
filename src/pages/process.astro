---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { stages, findingParts, severities, reportContents, scopeFactors } from '../data/process';
import { site } from '../data/site';

// A small animated preview for each report section, in the order of reportContents.
const previews = ['summary', 'register', 'scores', 'evidence', 'plan', 'conformance'];
---

<Layout title="How it works" current="process">
  <section class="intro">
    <div class="intro-inner">
      <Eyebrow>How it works</Eyebrow>
      <h1 class="display-1">How an audit<br /><span class="accent">works, step by step.</span></h1>
      <p>
        Five stages, from a free scoping call to the re-check that confirms the rust is gone. At every stage you know exactly
        what we need from you and what you’ll get next.
      </p>
      <div class="facts">
        <span>{site.auditDuration}, typically</span>
        <span>Fixed price, agreed upfront</span>
        <span>Re-check included</span>
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section aria-label="Audit stages" class="stages" data-stages>
    <ol>
      {
        stages.map((stage, i) => (
          <li>
            <div class="rail">
              <span class:list={['num', 'mono', stage.style && `num--${stage.style}`]}>{i + 1}</span>
              <span class="line" aria-hidden="true" />
            </div>
            <div class:list={['stage', stage.style === 'client' && 'stage--client']}>
              <div class="stage-head">
                <h2>{stage.name}</h2>
                <span>{stage.when}</span>
              </div>
              <p class="stage-body">{stage.body}</p>
              <div class="stage-boxes">
                <div>
                  <p>What we need from you</p>
                  <p>{stage.need}</p>
                </div>
                <div>
                  <p>What you get</p>
                  <p>{stage.get}</p>
                </div>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Anatomy of a finding -->
  <section aria-labelledby="anat-h" class="section">
    <div class="container--wide anatomy" data-anatomy>
      <div class="anatomy-sample">
        <article aria-label="Sample finding" class="finding">
          <span class="finding-hole" aria-hidden="true"></span>
          <div class="finding-top">
            <span class="mono finding-id" data-part="1">AUD-014 · System logic</span>
            <span class="mono finding-sev" data-part="2">Major</span>
          </div>
          <h3>Payment marked successful before the mobile-money callback returns</h3>
          <div class="finding-part" data-part="3">
            <p>Evidence</p>
            <p>Recording on a throttled connection: success screen shown, callback fails, customer charged with no order.</p>
          </div>
          <div class="finding-part" data-part="4">
            <p>Steps to reproduce</p>
            <p>Android 10, 3G profile with 2 s latency. Pay any bill, then lose the network for 5 seconds.</p>
          </div>
          <div class="finding-part" data-part="5">
            <p>Recommended fix</p>
            <p>Show a pending state with a reference number until the callback confirms.</p>
          </div>
          <span class="finding-status" data-part="6">Re-check: <span data-status>open</span></span>
        </article>
      </div>
      <div class="anatomy-copy">
        <Eyebrow>Anatomy of a finding</Eyebrow>
        <h2 id="anat-h">Every finding has the same six parts</h2>
        <div class="parts">
          {
            findingParts.map((part, i) => (
              <div class="part" data-part={i + 1}>
                <span aria-hidden="true" />
                <div>
                  <h3>{part.name}</h3>
                  <p>{part.body}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Severity -->
  <section aria-labelledby="sev-h" class="section">
    <div class="container centered">
      <Eyebrow>Severity</Eyebrow>
      <h2 id="sev-h" class="display-2">A severity that sets the order of work</h2>
      <div class="sev-grid">
        {
          severities.map((s) => (
            <div class="card">
              <span class="mono sev" style={`background: ${s.bg}; color: ${s.fg}`}>
                {s.name}
              </span>
              <p>{s.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Report contents -->
  <section aria-labelledby="rep-h" class="section">
    <div class="container report">
      <div class="report-intro">
        <Eyebrow>The report</Eyebrow>
        <h2 id="rep-h" class="display-2">What’s in your report</h2>
        <p class="lead">Written for two readers: the team that fixes the problems, and the leaders who decide what to fund first.</p>
        <a href="/report" class="btn btn--secondary btn--sm">Open the sample report</a>
      </div>
      <div class="report-grid" data-report-grid>
        {
          reportContents.map((item, i) => (
            <div class="card">
              <div class:list={['rp', `rp--${previews[i]}`]} aria-hidden="true">
                {previews[i] === 'summary' && (
                  <>
                    <b>20</b>
                    <small>findings</small>
                    <i style="--w: 92%" />
                    <i style="--w: 70%" />
                    <i style="--w: 48%" />
                  </>
                )}
                {previews[i] === 'register' && [1, 1, 0, 0].map((urgent) => <p class:list={{ 'is-urgent': urgent }}><span /><i /></p>)}
                {previews[i] === 'scores' && [62, 38, 80, 54, 30].map((h) => <i style={`--h: ${h}%`} />)}
                {previews[i] === 'evidence' && (
                  <>
                    <span class="rp-play" />
                    <span class="rp-bar"><i /></span>
                  </>
                )}
                {previews[i] === 'plan' &&
                  ['Now', 'Next', 'Later'].map((col, c) => (
                    <p>
                      <small>{col}</small>
                      {Array.from({ length: 3 - c }, () => <i />)}
                    </p>
                  ))}
                {previews[i] === 'conformance' && (
                  <>
                    <b>AA</b>
                    {[1, 1, 0].map((pass) => (
                      <p class:list={{ 'is-fail': !pass }}>
                        <span />
                        <i />
                      </p>
                    ))}
                  </>
                )}
              </div>
              <h3>{item.name}</h3>
              <p>{item.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section aria-labelledby="price-h" class="section">
    <div class="container--wide pricing">
      <div class="pricing-copy">
        <h2 id="price-h">One fixed price, agreed before we start</h2>
        <p>
          No hourly billing and no surprises. The price depends on the size of the inspection, and it includes the re-check.{' '}
          {site.pricingDetails}
        </p>
        <p class="pricing-promise">
          What we don’t promise: a specific conversion number. Results depend on what your team ships. What we do promise:
          every finding is real, evidenced and fixable.
        </p>
      </div>
      <div class="scope">
        <p>What shapes the scope</p>
        <ul>
          {
            scopeFactors.map((factor) => (
              <li>
                <span aria-hidden="true" />
                {factor}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { playLoop } from '../scripts/loop';

  // Timeline: as the page scrolls, the rail fills down, each stage lights up when the fill reaches it,
  // and each card rises in as it enters the view.
  const timeline = document.querySelector<HTMLElement>('[data-stages]');
  if (timeline && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    timeline.classList.add('is-scrolly');
    const items = [...timeline.querySelectorAll<HTMLElement>('li')];
    let queued = false;
    const update = () => {
      queued = false;
      const anchor = innerHeight * 0.6;
      items.forEach((li) => {
        const line = li.querySelector('.line')!.getBoundingClientRect();
        const num = li.querySelector('.num')!.getBoundingClientRect();
        li.style.setProperty('--fill', Math.min(1, Math.max(0, (anchor - line.top) / line.height)).toFixed(3));
        li.classList.toggle('is-reached', anchor > num.top + num.height / 2);
        if (li.getBoundingClientRect().top < innerHeight * 0.92) li.classList.add('is-seen');
      });
    };
    const queue = () => {
      if (!queued) requestAnimationFrame(update);
      queued = true;
    };
    addEventListener('scroll', queue, { passive: true });
    addEventListener('resize', queue);
    update();
  }

  // What's in your report: the section previews draw themselves while on screen.
  document.querySelectorAll<HTMLElement>('[data-report-grid]').forEach((root) =>
    playLoop(root, {
      duration: 9000,
      steps: [
        { at: 300, add: 'is-on' },
        { at: 8300, add: 'is-off' },
      ],
      still: ['is-on'],
    }),
  );

  // Anatomy of a finding: walk the six parts in turn, lighting each on the card and in the list,
  // then take the re-check from open to fixed to confirmed.
  const status = (root: HTMLElement, text: string) => {
    root.querySelector<HTMLElement>('[data-status]')!.textContent = text;
  };
  const beat = (n: number) => (root: HTMLElement) => {
    root.dataset.beat = String(n);
  };

  document.querySelectorAll<HTMLElement>('[data-anatomy]').forEach((root) =>
    playLoop(root, {
      duration: 14400,
      steps: [
        { at: 0, add: 'is-live', run: (r) => { beat(0)(r); status(r, 'open'); } },
        ...[1, 2, 3, 4, 5, 6].map((n, i) => ({ at: 600 + i * 1800, add: `is-b${n}`, run: beat(n) })),
        { at: 10500, add: 'is-fixed', run: (r) => status(r, 'fixed') },
        { at: 11400, add: 'is-confirmed', run: (r) => status(r, 'confirmed') },
        { at: 12600, add: 'is-rest', run: beat(0) },
      ],
      still: [],
    }),
  );
</script>

<style>
  .intro {
    padding: 96px var(--gutter) 72px;
  }

  .intro-inner {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 24px;
  }

  .intro-inner > p {
    margin: 0;
    max-width: 38em;
    font-size: 19px;
    line-height: 1.65;
    color: var(--steel);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 6px;
  }

  .facts span {
    font-size: 15px;
    font-weight: 600;
    padding: 10px 16px;
    border-radius: 999px;
    background: var(--white);
    border: 1px solid rgba(19, 32, 46, 0.1);
  }

  @media (max-width: 640px) {
    .intro {
      padding: 48px var(--gutter) 48px;
    }

    .intro-inner {
      gap: 20px;
    }

    .intro-inner > p {
      font-size: 17px;
      line-height: 1.6;
    }

    /* The three facts become one tidy card instead of a ragged stack of pills */
    .facts {
      align-self: stretch;
      flex-direction: column;
      gap: 0;
      margin-top: 0;
      background: var(--white);
      border: 1px solid rgba(19, 32, 46, 0.1);
      border-radius: 16px;
    }

    .facts span {
      padding: 12px 16px;
      border: 0;
      border-radius: 0;
      background: none;
      font-size: 14px;
    }

    .facts span + span {
      border-top: 1px solid var(--line);
    }
  }

  /* Timeline */
  .stages {
    padding: 0 var(--gutter) 96px;
  }

  .stages ol {
    max-width: 960px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .stages li {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    gap: 28px;
  }

  .rail {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .num {
    flex: none;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--navy);
    color: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 17px;
    font-weight: 500;
  }

  .num--client {
    border: 2px dashed var(--steel);
    color: var(--steel);
    background: var(--ground);
  }

  .num--final {
    background: var(--rust);
  }

  .line {
    flex: 1;
    width: 2px;
    background: rgba(19, 32, 46, 0.12);
    margin-top: 8px;
  }

  /* Scroll-driven timeline (added by the script, so it stays static without it) */
  .is-scrolly .line {
    position: relative;
    overflow: hidden;
    border-radius: 2px;
  }

  .is-scrolly .line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--rust), #e0733f);
    transform: scaleY(var(--fill, 0));
    transform-origin: top;
  }

  .is-scrolly .num {
    transition: opacity 400ms ease, transform 600ms cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 500ms ease;
  }

  .is-scrolly li:not(.is-reached) .num {
    opacity: 0.35;
    transform: scale(0.82);
  }

  .is-scrolly li.is-reached .num { box-shadow: 0 0 0 6px rgba(194, 81, 31, 0.14); }

  .is-scrolly .stage {
    transition: opacity 600ms ease, transform 800ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 500ms ease;
  }

  .is-scrolly li:not(.is-seen) .stage {
    opacity: 0;
    transform: translateY(28px);
  }

  .is-scrolly li.is-reached .stage { box-shadow: 0 24px 48px -28px rgba(19, 32, 46, 0.25); }

  .stage {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 22px;
    padding: 32px;
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .stage--client {
    background: var(--ground);
    border: 1px dashed rgba(19, 32, 46, 0.25);
  }

  .stage-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px 20px;
  }

  .stage-head h2 {
    margin: 0;
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .stage-head span {
    font-size: 15px;
    font-weight: 600;
    color: var(--rust-text);
  }

  .stage-body {
    margin: 0;
    max-width: 44em;
    font-size: 17px;
    line-height: 1.65;
    color: var(--steel);
  }

  .stage-boxes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 14px;
  }

  .stage-boxes > div {
    background: var(--paper);
    border-radius: 14px;
    padding: 16px 18px;
  }

  .stage-boxes p {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
  }

  .stage-boxes p:first-child {
    margin-bottom: 6px;
    font-size: 13px;
    font-weight: 700;
    color: var(--steel);
  }

  @media (max-width: 640px) {
    .stages li {
      grid-template-columns: 40px minmax(0, 1fr);
      gap: 14px;
    }

    .num {
      width: 40px;
      height: 40px;
      font-size: 15px;
    }

    .stage {
      padding: 22px 20px;
    }
  }

  /* Anatomy */
  .anatomy {
    background: var(--white);
    border: 1px solid rgba(19, 32, 46, 0.07);
    border-radius: 30px;
    padding: 64px 56px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
    gap: 56px;
    align-items: center;
  }

  .anatomy-sample {
    background: var(--navy);
    border-radius: 24px;
    padding: 44px 36px;
  }

  .finding {
    position: relative;
    background: var(--paper);
    border-radius: 18px;
    padding: 30px 30px 30px 62px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    transform: rotate(-1.5deg);
  }

  .finding-hole {
    position: absolute;
    left: 24px;
    top: 34px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--navy);
    box-shadow: inset 0 0 0 4px var(--rust);
  }

  .finding-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px;
    font-size: 14px;
    color: var(--steel);
  }

  .finding-sev {
    font-size: 13px;
    background: var(--steel);
    color: var(--white);
    padding: 4px 10px;
    border-radius: 7px;
  }

  .finding h3 {
    margin: 0;
    font-size: 22px;
    line-height: 1.3;
    font-weight: 700;
  }

  .finding-part p {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
  }

  .finding-part p:first-child {
    margin-bottom: 4px;
    font-size: 13px;
    font-weight: 700;
    color: var(--steel);
  }

  .finding-status {
    align-self: flex-start;
    font-size: 13px;
    font-weight: 700;
    background: var(--white);
    border: 1px solid rgba(19, 32, 46, 0.15);
    padding: 5px 11px;
    border-radius: 999px;
  }

  /* The six parts light up in turn while the section is on screen */
  .finding [data-part],
  .part {
    transition: background 400ms ease, box-shadow 400ms ease, opacity 400ms ease, color 400ms ease, transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .finding [data-part] { border-radius: 8px; }

  .anatomy.is-live:not([data-beat='0']) .part { opacity: 0.45; }

  .anatomy[data-beat='1'] .finding [data-part='1'],
  .anatomy[data-beat='2'] .finding [data-part='2'],
  .anatomy[data-beat='3'] .finding [data-part='3'],
  .anatomy[data-beat='4'] .finding [data-part='4'],
  .anatomy[data-beat='5'] .finding [data-part='5'] {
    background: var(--white);
    box-shadow: 0 0 0 8px var(--white), 0 0 0 10px var(--rust), 0 18px 30px -16px rgba(194, 81, 31, 0.6);
  }

  .anatomy[data-beat='2'] .finding [data-part='2'] {
    background: var(--rust);
    box-shadow: 0 0 0 4px var(--white), 0 0 0 6px var(--rust);
    transform: scale(1.08);
  }

  .anatomy[data-beat='6'] .finding [data-part='6'] {
    box-shadow: 0 0 0 4px var(--paper), 0 0 0 6px var(--rust);
    transform: scale(1.06);
  }

  .anatomy.is-fixed .finding-status { color: var(--white); background: var(--steel); border-color: var(--steel); }
  .anatomy.is-confirmed .finding-status { background: linear-gradient(135deg, #e0733f, #c2511f); border-color: var(--rust); }

  .anatomy[data-beat='1'] .part[data-part='1'],
  .anatomy[data-beat='2'] .part[data-part='2'],
  .anatomy[data-beat='3'] .part[data-part='3'],
  .anatomy[data-beat='4'] .part[data-part='4'],
  .anatomy[data-beat='5'] .part[data-part='5'],
  .anatomy[data-beat='6'] .part[data-part='6'] { opacity: 1; transform: translateX(6px); }

  .part > span { transition: transform 400ms cubic-bezier(0.34, 1.5, 0.64, 1), box-shadow 400ms ease; }

  .anatomy[data-beat='1'] .part[data-part='1'] > span,
  .anatomy[data-beat='2'] .part[data-part='2'] > span,
  .anatomy[data-beat='3'] .part[data-part='3'] > span,
  .anatomy[data-beat='4'] .part[data-part='4'] > span,
  .anatomy[data-beat='5'] .part[data-part='5'] > span,
  .anatomy[data-beat='6'] .part[data-part='6'] > span { transform: scale(1.3); box-shadow: 0 0 0 5px rgba(194, 81, 31, 0.18); }

  /* The tag sways a little, like it hangs from its hole */
  @media (prefers-reduced-motion: no-preference) {
    .anatomy.is-live .finding { animation: tag-sway 6s ease-in-out infinite; transform-origin: 32px 42px; }
  }

  @keyframes tag-sway {
    0%, 100% { transform: rotate(-1.5deg); }
    50% { transform: rotate(-0.4deg); }
  }

  .anatomy-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }

  .anatomy-copy h2 {
    margin: 0;
    font-size: clamp(34px, 4vw, 52px);
    line-height: 1.06;
    font-weight: 700;
    letter-spacing: -0.035em;
  }

  .parts {
    display: flex;
    flex-direction: column;
  }

  .part {
    display: flex;
    gap: 16px;
    padding: 18px 0;
    border-top: 1px solid rgba(19, 32, 46, 0.1);
  }

  .part > span {
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--rust);
    margin-top: 7px;
  }

  .part h3 {
    margin: 0 0 4px;
    font-size: 17px;
    font-weight: 700;
  }

  .part p {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--steel);
  }

  @media (max-width: 640px) {
    .anatomy {
      padding: 40px 20px;
    }

    .anatomy-sample {
      padding: 28px 16px;
    }

    .finding {
      padding: 24px 20px 24px 52px;
    }

    .finding-hole {
      left: 20px;
      top: 28px;
    }
  }

  /* Severity and report cards */
  .centered {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
  }

  .centered > h2 {
    text-align: center;
  }

  .card {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 26px;
    display: flex;
    flex-direction: column;
  }

  .card p {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--steel);
  }

  .sev-grid {
    width: 100%;
    margin-top: 24px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
    gap: 18px;
  }

  .sev-grid .card {
    gap: 14px;
  }

  .sev {
    align-self: flex-start;
    font-size: 14px;
    font-weight: 500;
    border: 1px solid rgba(19, 32, 46, 0.15);
    padding: 6px 12px;
    border-radius: 8px;
  }

  .report {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .report-intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    max-width: 720px;
  }

  .report-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 18px;
